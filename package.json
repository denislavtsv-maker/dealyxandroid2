{
  "name": "dealyx-app",
  "version": "1.0.0",
  "private": true,
  "description": "DEALYX Android and iOS app shell using the current Dealyx website branding and backend.",
  "scripts": {
    "sync": "cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "assets:generate": "capacitor-assets generate --android --assetPath assets --iconBackgroundColor '#f7f8f1' --iconBackgroundColorDark '#0f1913' --splashBackgroundColor '#f8f9f2' --splashBackgroundColorDark '#0f1913'"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@capacitor/android": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/splash-screen": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@capacitor/assets": "^3.0.5",
    "typescript": "^5.8.3"
  }
}
